rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === HELPER FUNCTIONS ===

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && role in getUserData().role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isFinancial() {
      return hasRole('financial') || isAdmin();
    }

    function isKhidmat() {
      return hasRole('khidmat') || isAdmin();
    }


    // === SYSTEM SETTINGS ===
    match /system_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // === USERS (Team members) ===
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // === SEHRI REGISTRATIONS ===
    match /sehri_registrations/{docId} {
      // Anyone can submit (public form)
      allow create: if true;
      // Only team members can read
      allow read: if isAuthenticated();
      // Only financial team or admin can update (verify payments)
      allow update: if isFinancial();
      // Only admin can delete
      allow delete: if isAdmin();
    }


    // === FEEDBACK SUBMISSIONS ===
    match /feedback_submissions/{docId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }


    // === DONATIONS ===
    match /donations/{docId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }


    // === FINANCIAL TRANSACTIONS ===
    match /financial_transactions/{docId} {
      allow read: if isFinancial();
      allow create: if isFinancial();
      allow update, delete: if isFinancial();
    }


    // === DAILY ATTENDANCE ===
    match /daily_attendance/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isKhidmat();
      allow delete: if isAdmin();
    }


    // === DAILY CHECKLISTS ===
    match /daily_checklists/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isKhidmat();
      allow delete: if isAdmin();
    }


    // === CHECKLIST TEMPLATES ===
    match /checklist_templates/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // === GALLERY IMAGES ===
    match /gallery_images/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // === YEAR PHOTOS ===
    match /year_photos/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // === AUDIT LOGS ===
    match /audit_logs/{docId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;  // Immutable
    }
  }
}
